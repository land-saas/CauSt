.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.toc
*.synctex.gz

# Data & results (large files)
data/
results/
*.h5ad
*.zarr

# Vendored third-party sources (cloned locally, not tracked)
third_party/

# IDE
.vscode/
.idea/
*.swp

# OS metadata
.DS_Store
Thumbs.db

# Logs and checkpoints
*.log
*.pth
*.ckpt
