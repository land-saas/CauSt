# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.so

# Virtual environments
venv/
.venv/
env/

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/
site/

# Test & type-check caches
.pytest_cache/
