# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.so

# Virtual environments
venv/
.venv/
env/

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/
site/

# Test & type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.toc
*.synctex.gz

# Data & results (large files)
data/

# Run outputs are regenerable from configs/, so they are not tracked by
# default. A specific result can still be committed as a reference point with
# `git add -f results/<run_id>` -- the manifest records the commit and
# environment it came from, so a tracked run stays meaningful.
results/*
!results/.gitkeep

# Scratch dirs created by `make determinism` and `make lock`.
.determinism/
.lockenv/
*.h5ad
*.zarr

# Vendored third-party sources (cloned locally, not tracked)
third_party/

# IDE
.vscode/
.idea/
*.swp

# OS metadata
.DS_Store
Thumbs.db

# Logs and checkpoints
*.log
*.pth
*.ckpt
